[sub_resource type="RectangleShape2D" id="RectangleShape2D_junction"]
size = Vector2(180, 180)

; Tread motion. Reuses the splitter/Y-field shader logic (mode 2) with the
; branch fan reversed: fan_y is negated so the diagonal-flow region sits
; ABOVE the pivot (the two inbound arms) instead of below it, and branch_th
; is negated so those arms flow down-and-inward toward the chamber instead
; of down-and-outward. Below the pivot the field is untouched (pure vertical
; flow), matching the output stem. dir_sign stays +1 throughout: both the
; reversed-fan arms and the unreversed stem now read as flowing downward,
; i.e. inbound treads feed toward the chamber and the outbound tread
; continues away from it. pivot/fan tuned to the measured disc centre
; (656, 624) and the fan_x/branch_th carried over from the approved
; splitter tuning (arm angle measured to within ~1 deg of the splitter's).
[sub_resource type="ShaderMaterial" id="ShaderMaterial_tread_junction"]
shader = ExtResource("5_tread_shader")
shader_parameter/tex_size = Vector2(1312, 1199)
shader_parameter/mode = 2
shader_parameter/speed_tex = 539.92
shader_parameter/wrap_tex = 98.0
shader_parameter/dir_sign = 1.0
shader_parameter/blend_frac = 0.3
shader_parameter/valid_min = 180.0
shader_parameter/valid_max = 1080.0
shader_parameter/pivot = Vector2(656, 624)
shader_parameter/branch_th = -0.74654
shader_parameter/fan_x = 70.0
shader_parameter/fan_y = -240.0
shader_parameter/tread_mask = ExtResource("6_mask_junction_main")

