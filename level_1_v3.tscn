texture = SubResource("GradientTexture2D_route_band")
texture_mode = 2
joint_mode = 2
begin_cap_mode = 2
end_cap_mode = 2

; Route flow: four chevrons riding the selected output arm at belt speed, so
; the direction the cargo will take is shown as motion, not just as a lit lane.
; Positions, headings, colour and end fades are driven by level_1_v3.gd from the
; active Path2D itself, so they can never disagree with the route.
