[node name="RouteIndicators" type="Node2D" parent="."]
z_index = 10

; Route indication is a soft illuminated lane lying ON the belt: a wide, very
; faint halo under a narrower band, both feathered across their width by
; Gradient_route_band so neither shows a hard edge. Peak additive alpha is ~0.23,
; low enough that the tread and its chevrons read straight through it. Trimmed by
; level_1_v3.gd so the band -- including its round end caps -- starts outside the
; Junction platform (r >= 92) and stops above the bin rim (y <= 884).
[node name="RouteBeamGlow" type="Line2D" parent="RouteIndicators"]
texture_repeat = 1
material = SubResource("CanvasItemMaterial_add")
points = PackedVector2Array(0, 0)
width = 27.0
default_color = Color(1, 0.38, 0.29, 0.1)
texture = SubResource("GradientTexture2D_route_band")
texture_mode = 2
joint_mode = 2
begin_cap_mode = 2
end_cap_mode = 2

